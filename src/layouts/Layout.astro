---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | beathunterzero</title>

    <meta
      name="description"
      content="Portafolio profesional de Rhodyn Ildefonso, orientado a Threat Hunting, Detection Engineering, DFIR, Incident Response y Cloud Security."
    />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://beathunterzero.github.io/" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Rhodyn Ildefonso | Threat Hunter & Detection Engineer"
    />
    <meta
      property="og:description"
      content="Portafolio profesional enfocado en Threat Hunting, Detection Engineering, DFIR, Incident Response y Cloud Security."
    />
    <meta
      property="og:image"
      content="https://beathunterzero.github.io/og-image.png"
    />
    <meta property="og:url" content="https://beathunterzero.github.io" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rhodyn Ildefonso Portfolio" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Rhodyn Ildefonso",
        "alternateName": "beathunterzero",
        "url": "https://beathunterzero.github.io",
        "sameAs": [
          "https://github.com/beathunterzero",
          "https://www.linkedin.com/in/rhodyn-ildefonso-4ba73b1b8/"
        ],
        "jobTitle": "Threat Hunter & Detection Engineer",
        "description": "Profesional de Ciberseguridad enfocado en Threat Hunting, Detection Engineering, DFIR, Incident Response y Cloud Security.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Huaral",
          "addressRegion": "Lima",
          "addressCountry": "PE"
        }
      }
    </script>
  </head>

  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--white-icon-tr);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--sec) var(--background);
  }
</style>