---
interface Project {
  title: string;
  category: string;
  description: string;
  link: string;
  status: string;
  tags: string[];
}

const projects: Project[] = [
  {
    title: "cyber-threat-hunting",
    category: "Threat Hunting Knowledge Base",
    description:
      "Technical documentation repository and Threat Hunting lab based on hypotheses, MITRE ATT&CK, and Cyber Kill Chain. It includes investigations, methodologies, analysis, and reference material for Threat Hunting operations.",
    link: "https://github.com/beathunterzero/cyber-threat-hunting",
    status: "Active",
    tags: [
      "Threat Hunting",
      "MITRE ATT&CK",
      "Cyber Kill Chain",
      "Documentation",
      "Detection",
    ],
  },
  {
    title: "cyber-threat-hunting-lab-logs",
    category: "Threat Hunting Lab Logs",
    description:
      "Lab repository with controlled logs, PCAP files, queries, analyst notes, and technical evidence to reproduce hypothesis-based Threat Hunting investigations.",
    link: "https://github.com/beathunterzero/cyber-threat-hunting-lab-logs",
    status: "Active",
    tags: [
      "Lab Logs",
      "PCAP",
      "KQL",
      "Telemetry",
      "Threat Hunting",
    ],
  },
  {
    title: "elastic-security-lab",
    category: "Detection Engineering Lab",
    description:
      "Local Elastic Security lab for log ingestion, telemetry analysis, Kibana visualization, and development of searches oriented toward Threat Hunting and Detection Engineering.",
    link: "https://github.com/beathunterzero/elastic-security-lab",
    status: "Active",
    tags: [
      "Elastic Security",
      "Kibana",
      "Filebeat",
      "Docker",
      "Detection Engineering",
    ],
  },
  {
    title: "engineering-knowledge-base",
    category: "Technical Knowledge Base",
    description:
      "Technical knowledge base about tools, automation, and work environment configuration with PowerShell, Git, WSL, Python, and Docker, focused on practical and reusable documentation.",
    link: "https://github.com/beathunterzero/engineering-knowledge-base",
    status: "Active",
    tags: [
      "PowerShell",
      "Git",
      "WSL",
      "Python",
      "Docker",
      "Documentation",
    ],
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">
      Technical Portfolio
    </h2>

    <h3 class="text-4xl md:text-5xl font-medium mb-8">
      Projects
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <article class="group h-full rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6 transition-all duration-300 hover:bg-[var(--white-icon-tr)] hover:scale-[1.01]">
            <div class="mb-4">
              <span class="inline-flex items-center rounded-full border border-[var(--white-icon-tr)] px-3 py-1 text-xs text-[var(--sec)] mb-3">
                {project.category}
              </span>

              <h4 class="text-2xl font-semibold text-[var(--white)]">
                {project.title}
              </h4>

              <span class="block mt-1 text-sm text-[var(--white-icon)]">
                {project.status}
              </span>
            </div>

            <p class="text-[var(--white-icon)] text-sm leading-relaxed mb-5">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2 mb-6">
              {
                project.tags.map((tag) => (
                  <span class="rounded-full border border-[var(--white-icon-tr)] px-3 py-1 text-xs text-[var(--white-icon)]">
                    {tag}
                  </span>
                ))
              }
            </div>

            <a
              target="_blank"
              href={project.link}
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-[var(--sec)] hover:text-[var(--white)] transition duration-300"
            >
              View repository
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-4"
              >
                <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>

    <a
      target="_blank"
      href="https://github.com/beathunterzero?tab=repositories"
      rel="noopener noreferrer"
      aria-label="View more repositories on GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">
        View more repositories on GitHub
      </span>

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>