---

<section class="relative py-8" aria-label="Tecnologías y herramientas">
  <div class="flex items-center justify-between gap-4 mb-4">
    <h3 class="text-[var(--white)] text-xl md:text-2xl font-medium">
      Tecnologías y herramientas
    </h3>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="logo-prev"
        aria-label="Retroceder tecnologías"
        class="flex items-center justify-center w-9 h-9 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] text-[var(--white-icon)] hover:text-[var(--white)] hover:bg-[var(--white-icon-tr)] transition duration-300"
      >
        ‹
      </button>

      <button
        type="button"
        id="logo-toggle"
        aria-label="Pausar carrusel"
        class="flex items-center justify-center w-9 h-9 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] text-[var(--white-icon)] hover:text-[var(--white)] hover:bg-[var(--white-icon-tr)] transition duration-300"
      >
        ❚❚
      </button>

      <button
        type="button"
        id="logo-next"
        aria-label="Adelantar tecnologías"
        class="flex items-center justify-center w-9 h-9 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] text-[var(--white-icon)] hover:text-[var(--white)] hover:bg-[var(--white-icon-tr)] transition duration-300"
      >
        ›
      </button>
    </div>
  </div>

  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-y-0 left-0 w-24 md:w-32 bg-gradient-to-r from-[var(--background)] to-transparent z-20"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 w-24 md:w-32 bg-gradient-to-l from-[var(--background)] to-transparent z-20"
    >
    </div>

    <div
      id="logo-track"
      class="flex gap-12 md:gap-20 overflow-x-auto scroll-smooth cursor-grab select-none no-scrollbar py-4"
    >
      {
        duplicatedTechnologies.map((tech, index) => (
          <div
            class="flex items-center gap-2 shrink-0 group transition-all duration-300"
            aria-hidden={index >= technologies.length ? "true" : "false"}
          >
            <img
              src={`/svg/${tech.icon}.svg`}
              alt={tech.name}
              class="h-7 w-auto object-contain transition-transform group-hover:scale-110 opacity-60"
              width="30"
              height="30"
              loading={index < technologies.length ? "eager" : "lazy"}
              decoding="async"
              draggable="false"
            />

            <span class="text-lg font-medium text-[var(--white-icon)] whitespace-nowrap group-hover:text-[var(--white)] transition duration-300">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  const track = document.getElementById("logo-track");
  const prevButton = document.getElementById("logo-prev");
  const nextButton = document.getElementById("logo-next");
  const toggleButton = document.getElementById("logo-toggle");

  let isPaused = false;
  let isDragging = false;
  let startX = 0;
  let startScrollLeft = 0;
  let animationFrameId = null;

  const autoScrollSpeed = 0.35;
  const manualScrollAmount = 320;

  function getLoopPoint() {
    return track.scrollWidth / 2;
  }

  function normalizeScrollPosition() {
    const loopPoint = getLoopPoint();

    if (track.scrollLeft >= loopPoint) {
      track.scrollLeft = track.scrollLeft - loopPoint;
    }

    if (track.scrollLeft <= 0) {
      track.scrollLeft = loopPoint;
    }
  }

  function autoScroll() {
    if (!isPaused && !isDragging && track) {
      track.scrollLeft += autoScrollSpeed;
      normalizeScrollPosition();
    }

    animationFrameId = requestAnimationFrame(autoScroll);
  }

  function pauseCarousel() {
    isPaused = true;
    toggleButton.textContent = "▶";
    toggleButton.setAttribute("aria-label", "Reanudar carrusel");
  }

  function resumeCarousel() {
    isPaused = false;
    toggleButton.textContent = "❚❚";
    toggleButton.setAttribute("aria-label", "Pausar carrusel");
  }

  prevButton?.addEventListener("click", () => {
    track.scrollBy({
      left: -manualScrollAmount,
      behavior: "smooth",
    });
  });

  nextButton?.addEventListener("click", () => {
    track.scrollBy({
      left: manualScrollAmount,
      behavior: "smooth",
    });
  });

  toggleButton?.addEventListener("click", () => {
    if (isPaused) {
      resumeCarousel();
    } else {
      pauseCarousel();
    }
  });

  track?.addEventListener("mouseenter", pauseCarousel);
  track?.addEventListener("mouseleave", () => {
    if (!toggleButton || toggleButton.textContent !== "▶") {
      resumeCarousel();
    }
  });

  track?.addEventListener("mousedown", (event) => {
    isDragging = true;
    startX = event.pageX;
    startScrollLeft = track.scrollLeft;
    track.classList.add("cursor-grabbing");
  });

  window.addEventListener("mouseup", () => {
    isDragging = false;
    track?.classList.remove("cursor-grabbing");
  });

  track?.addEventListener("mousemove", (event) => {
    if (!isDragging) return;
    event.preventDefault();

    const movement = event.pageX - startX;
    track.scrollLeft = startScrollLeft - movement;
    normalizeScrollPosition();
  });

  track?.addEventListener("touchstart", (event) => {
    isDragging = true;
    startX = event.touches[0].pageX;
    startScrollLeft = track.scrollLeft;
  });

  track?.addEventListener("touchend", () => {
    isDragging = false;
  });

  track?.addEventListener("touchmove", (event) => {
    if (!isDragging) return;

    const movement = event.touches[0].pageX - startX;
    track.scrollLeft = startScrollLeft - movement;
    normalizeScrollPosition();
  });

  if (track) {
    animationFrameId = requestAnimationFrame(autoScroll);
  }

  window.addEventListener("beforeunload", () => {
    if (animationFrameId) {
      cancelAnimationFrame(animationFrameId);
    }
  });
</script>
